    "input": {
        "name": "example/sylius-shop-only-plugin",
        "searchRow": {
            "name": "example/sylius-shop-only-plugin",
            "downloads": 12000,
            "description": "Plugin depending only on shop-bundle",
            "repository": "https://github.com/example/sylius-shop-only-plugin"
        },
        "versions": [
            {
                "version": "v1.0.2",
                "version_normalized": "1.0.2.0",
                "require": {
                    "php": "^8.1",
                    "sylius/shop-bundle": "^2.0"
                }
            }
        ]
    },
    "expected": {
        "outcome": "ok",
        "entry": {
            "packageName": "example/sylius-shop-only-plugin",
            "latestTag": "v1.0.2",
